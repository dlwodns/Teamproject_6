# Railway web: 공개 주소 하나로 화면 + /api 프록시(deploy_decision.md R6). infra/railway_setup.md
# 변수: PORT(Railway가 넣음) · BACKEND_URL(예: http://backend.railway.internal:8000) · BASIC_AUTH_USER · BASIC_AUTH_HASH
# HTTPS는 Railway 앞단이 끝낸다. 여기는 http만 받는다.
:{$PORT:8080} {
	# 로그인이 생기기 전까지 사이트 전체를 기본 인증으로 막는다(deploy_decision.md 5절). 해시: caddy hash-password
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	# backend에는 접두어 없는 /health만 있다(vite.config.ts와 같은 규칙)
	handle /api/health {
		rewrite * /health
		reverse_proxy {$BACKEND_URL}
	}

	handle /api/* {
		reverse_proxy {$BACKEND_URL}
	}

	# 응답 압축(Caddy encode). /api JSON · 화면 파일 모두
	encode zstd gzip

	handle {
		root * /srv
		# Vite 빌드 파일(/assets)은 이름에 해시가 붙는다 → 오래 캐시. 나머지(index.html · 화면 경로)는 재배포가 바로 보이게 매번 확인.
		# header는 try_files보다 먼저 돌아 원래 경로로 판단한다(Caddy 기본 지시어 순서)
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
