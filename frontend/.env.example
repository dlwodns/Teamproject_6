# frontend 전용 예시. 복사해서 frontend/.env 로 쓴다(.env는 올리지 않는다).
# VITE_ 로 시작하는 값은 빌드 결과에 그대로 들어가 누구나 볼 수 있다. 비밀값을 넣지 않는다.

# 데이터 모드: mock(기본, 비워 두면 mock) | http(실제 backend). 실제 모드 실패를 모의 데이터로 대신하지 않는다.
VITE_API_MODE=mock
# 실제 모드에서 부를 주소 앞부분. 개발 서버에서는 Vite 프록시가 /api 를 backend로 넘긴다.
VITE_API_BASE=/api
# 실제 모드에서 X-User-Id 헤더로 보낼 사용자 번호. 비우면 1(시연 사용자). 운영 모드 backend는 이 헤더가 없으면 업무 변경을 401로 막는다
VITE_USER_ID=1

# 개발 서버(vite.config.ts) 전용 — 화면 코드로 넘어가지 않는다. 프록시가 요청을 넘길 backend 주소.
BACKEND_PROXY_TARGET=http://127.0.0.1:8000
