{
  "name": "ax-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.ts\"",
    "mock:extract": "node scripts/extract-mock.mjs",
    "mock:check": "node scripts/extract-mock.mjs --check",
    "tokens:export": "node scripts/tokens-export.mjs",
    "tokens:check": "node scripts/tokens-export.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
