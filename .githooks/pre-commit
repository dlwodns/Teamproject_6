#!/bin/sh
# 커밋 전 경계 · 비밀값 검사 (INF-8, infra/plan.md). 규칙은 scripts/check_boundaries.py 머리말.
# 설치(클론마다 한 번): git config core.hooksPath .githooks
# 막혔는데 가짜 값이 맞으면 그 줄 끝에 boundary-ok 를 적는다. --no-verify로 건너뛴 커밋도 PR CI가 다시 검사한다.
for c in python3 python py; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
    exec "$c" "$(git rev-parse --show-toplevel)/scripts/check_boundaries.py" --staged
  fi
done
echo "pre-commit: Python 3.10 이상을 찾지 못해 경계 · 비밀값 검사를 건너뛴다(PR CI가 다시 검사한다)" >&2
exit 0
