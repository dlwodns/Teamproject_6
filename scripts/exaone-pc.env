# PC에서 돌리는 엑사원(ollama)에 붙는 설정. scripts/exaone-pc.sh가 읽는다. 비밀값은 넣지 않는다.
# PC(LG gram)의 ollama → 역방향 SSH 터널 → 서버의 Unix 소켓(본인만 접근, 0700 폴더) → ai 서비스
# 서버 메모리 한도(5 GiB) 때문에 7.8B를 서버에 올리지 않는다(AI-T4).

LLM_BACKEND=ollama
OLLAMA_UDS=$HOME/run/exaone/ollama.sock
EXAONE_MODEL=hf.co/LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct-GGUF:Q4_K_M

# 고정값(선택): 비어 있으면 확인하지 않고 경고만 낸다. 채우면 다를 때 ai 서비스가 엑사원을 부르지 않고(규칙 결과만) 실행기도 멈춘다.
# 평가 수치를 남기려면 `scripts/exaone-pc.sh pin`으로 PC에서 읽은 값을 채운다. 바꿀 때는 평가를 다시 돌린다(eval/README.md).
EXAONE_MODEL_DIGEST=099a498b9cbfbfb008bebd4ff37fbe2eadb303ac01eb778852be6a196699e3fa
OLLAMA_VERSION=0.34.0

LLM_TIMEOUT_S=120
