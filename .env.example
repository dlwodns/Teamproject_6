# 복사해서 .env로 쓰고, 값은 각자 채운다. .env는 올리지 않는다.

# --- 공용 개발 서버 (scripts/run_dev.py가 팀원에게 보낼 화면 주소를 찍을 때만 쓴다) ---
# DEV_PUBLIC_HOST=             # 서버 공인 주소. 포트는 계정마다 3000+번호(user41 → 3041)라 적지 않는다

# --- ai 서비스 (backend가 부르는 주소) ---
AI_SERVICE_URL=http://localhost:8001
# AI_BACKGROUND_TIMEOUT_S=190  # backend가 ai 백그라운드 호출(분류 · 문맥 기억 · 신호)을 기다리는 초(AI-28). ai LLM_BACKGROUND_TIMEOUT_S보다 10초 이상 길게.
#                                대화형(명령 해석 · 다듬기)은 화면 140초에 맞춰 130초 고정. 30~1800, 틀리면 backend가 뜨지 않는다

# --- 엑사원 (ai/에서만 읽는다). 서비스에서 쓰는 외부 모델 키는 엑사원 API 하나뿐이다(D53). 다른 외부 모델 키는 아래 평가 전용 칸에만 둔다 ---
# 엑사원 API 키. 실제 키는 .env에만 넣고 레포 · 문서에 쓰지 않는다. 발급: https://docs.exaone.ai/ko/my-profile/api-key
EXAONE_API_KEY=<your-key>   # 여러 개면 쉼표로: 키1,키2 — 앞 키가 하루 한도(100회) 소진 · 거절이면 다음 키(AI-47)
# 키 유효기간은 발급일부터 30일이다(docs.exaone.ai 약관 3.4). 401이 나면 새로 발급한다
# 실행기는 이 값 하나로 바꿔 끼운다(D52): exaone_api(기본, 엑사원 API) | ollama | llamacpp (뒤의 둘은 로컬 실행기)
LLM_BACKEND=exaone_api
# EXAONE_API_BASE_URL=https://api.exaone.ai/v1
# EXAONE_API_MODEL=k-exaone_v2.5      # API 모델 이름. 로컬 모델 이름(EXAONE_MODEL)과 따로 둔다
# EXAONE_REASONING_EFFORT=           # low | high | max. 비우면 API 기본(max). 추론은 끌 수 없다
# 로컬 옵션(LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
EXAONE_MODEL=hf.co/LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct-GGUF:Q4_K_M   # 모델 받기 · 버전: eval/README.md 1~2절
# 개발 서버에서 PC 엑사원을 쓸 때 아래 값은 scripts/exaone-pc.env 한 곳에 두고 scripts/exaone-pc.sh run 으로 넣는다(AI-D9)
# OLLAMA_UDS=                  # PC 터널 Unix 소켓 경로
# EXAONE_MODEL_DIGEST=         # 고정값: 다르면 엑사원을 부르지 않는다
# OLLAMA_VERSION=              # 고정값: 다르면 엑사원을 부르지 않는다

# --- 메일 연동 ---
MS_GRAPH_CLIENT_ID=            # <여기에 주입>
MS_GRAPH_CLIENT_SECRET=        # <여기에 주입>
MS_GRAPH_REDIRECT_URI=http://localhost:5173/api/accounts/outlook/callback  # Entra 앱 등록의 리디렉션 URI와 같게(화면 프록시 경유)
MAIL_SOURCE=dummy              # dummy | outlook_graph (IMAP은 이번 단계 범위 밖)
# MS_GRAPH_TENANT=consumers    # 개인 Outlook.com만 consumers, 회사 · 학교 계정도 받으려면 common
# APP_URL=                     # callback 뒤 돌아갈 화면 주소. 화면 프록시(5173)로 같은 출처면 비워 둔다
# GRAPH_NOTIFY_URL=            # Graph 변경 알림을 받을 공개 HTTPS 주소(예: https://cne.example.com). 비우면 1분 폴링만(로컬 개발)

# --- 보안 ---
TOKEN_ENCRYPTION_KEY=          # 메일 토큰 암호화 키 <여기에 주입>
# PII_MASK=1                    # ai로 보내기 전 개인정보 가리기(BE-6). 기본 켜짐, 0이면 끔(디버깅용). backend/app/privacy/mask.py

# --- 알림 · 리마인더 (backend) ---
VAPID_PUBLIC_KEY=              # 웹 푸시 <여기에 주입>
VAPID_PRIVATE_KEY=             # 웹 푸시 <여기에 주입>
APP_MODE=dev                   # dev | prod (dev에서만 더미 적재. 시간 이동 · 리마인더 강제 실행은 아래 DEMO_TOOLS)
REMINDER_SCHEDULER=             # 1이면 리마인더 엔진을 1분마다 돌려 알림을 만든다(BE-12, APScheduler 1프로세스). 비우면 꺼짐
REMINDER_SIGNALS=               # 1이면 ai /signals로 약속 · 기한 변경 · 해결 신호를 받는다(BE-12 · AI-24). 엑사원을 연결한 뒤 켠다
CLASSIFY_WORKER=                # 1이면 메일 분류 작업자를 서버와 함께 띄운다(PL-16, BE-D19). 비우면 꺼짐
MEMORY_EXTRACT=                 # 1이면 분류 뒤 문맥 기억(모델)을 부른다(BE-D21). 엑사원을 연결한 뒤 켠다
# BRIEFING_HEADLINE=1            # AI-29 요약 · 회고 머리 문장 미리 만들기. 0이면 끔(REMINDER_SCHEDULER=1일 때만 돎)
# CLASSIFY_WORKER_INTERVAL=5     # 분류 작업자가 대기 작업이 없을 때 쉬는 초
# CLASSIFY_WORKERS=2            # 분류 작업자 스레드 수(1~8)
# CLASSIFY_PARALLEL=2           # 작업자 하나가 한 번에 보내는 분류 수. WORKERS × PARALLEL이 8을 넘으면 줄인다
# CLASSIFY_QUOTA_WAIT=600       # 엑사원 하루 호출 한도를 다 썼을 때 분류 작업자가 쉬는 초(풀릴 때까지 반복)
# DUMMY_MAIL_SOURCE=data/dummy/dummy_mails.json  # 더미 계정 메일 본문을 읽는 파일(본문은 DB에 저장하지 않음)
#   `seed load --source <파일>`로 다른 파일을 채웠으면 이 값도 같은 파일로 맞춘다. 다르면 메일 한 통 보기가 본문 없음(503)으로 끝난다(#87 리뷰)
DATABASE_URL=sqlite:///./ax.db # backend SQLite 파일 (backend/에서 실행 기준, .gitignore *.db). 배포 방식(INF-11)에 따라 바뀔 수 있다
CLOCK_START=                   # 시연 시작 시각. 비우면 실제 시각. 예) 2026-10-20T09:00 (시간대 없으면 KST) · 2026-10-20T00:00:00Z
#                                서버가 이 시각에서 시작해 실제 시간만큼 흐른다. 재시작하면 이 시각부터 다시. 틀린 값이면 뜨지 않는다
DEMO_TOOLS=                    # 1이면 시연 도구 /api/dev/clock(시간 이동) · /api/dev/reminders/run(리마인더 강제 실행)을 단다(BE-14). APP_MODE와 관계없다. 비우면 없음(404)
#                                prod 시연 서버에서 켜면 프록시 기본 인증으로 막는다. 단일 worker 전제(시각은 프로세스 메모리 값)

# --- MCP 서버 (backend, P2) ---
MCP_ACCESS_TOKEN=              # <여기에 주입>

# --- frontend (Vite) ---
# 이 루트 파일은 Vite가 자동으로 읽지 않는다. vite.config.ts에 root · envDir 설정이 없어 기본값(= Vite를 실행한 frontend/)을 쓰므로
# Vite는 frontend/.env · frontend/.env.<mode> 를 읽는다(npm 스크립트는 frontend/에서 실행됨). 값을 쓰려면 frontend/.env에 둔다.
# VITE_ 값은 빌드 결과에 그대로 들어가 누구나 볼 수 있다. 비밀값을 넣지 않는다. 예시 원본: frontend/.env.example
VITE_API_MODE=mock             # mock(기본) | http. 실제 모드 실패를 모의 데이터로 대신하지 않는다
VITE_API_BASE=/api             # 실제 모드 요청 주소 앞부분
VITE_USER_ID=1                 # 실제 모드 X-User-Id(로그인 전까지). 비우면 1, 운영 모드 backend는 없으면 401
# VITE_STT_MODE=browser        # 음성인식(D29): browser(기본, Web Speech API) | server(서버 Whisper — 아직 없어 🎤를 숨긴다)
# 개발 서버 프록시 대상(vite.config.ts가 loadEnv(mode, process.cwd(), '')로 frontend/.env* 또는 셸 환경 변수에서 읽음, 화면 코드로 넘어가지 않음)
BACKEND_PROXY_TARGET=http://127.0.0.1:8000   # 비우면 vite.config.ts 기본값 http://127.0.0.1:8000

# --- 음성 ---
STT_MODE=browser               # browser | server (server면 ai/의 Whisper)

# --- ai 조정값 (주석이면 코드 기본값. 바꿀 때만 주석을 풀고 값을 적는다) ---
# LLAMACPP_BASE_URL=http://127.0.0.1:30411   # LLM_BACKEND=llamacpp일 때 llama-server 주소
# LLM_TIMEOUT_S=120            # 대화형(명령 해석 · 다듬기 · 요약) 엑사원 호출 1회 제한 시간(초, API는 다시 부르기 포함). backend가 대화형을 기다리는 130초보다 짧게
# LLM_BACKGROUND_TIMEOUT_S=180  # 백그라운드 호출(분류 · 기억 추출 · 신호) 제한 시간(초, AI-28). LLM_TIMEOUT_S(대화형) 이상, backend AI_BACKGROUND_TIMEOUT_S보다 짧게
# OLLAMA_KEEP_ALIVE=30m        # 모델을 메모리에 두는 시간
# LLM_ENABLED=true             # false면 엑사원을 부르지 않는다(모델 없는 개발 환경, 분류는 '분류 실패'로 남음)

# --- 평가 전용 (eval/에서만 읽는다. scripts/run_dev.py는 서비스에 넘기지 않는다) ---
ANTHROPIC_API_KEY=             # <여기에 주입>
OPENROUTER_API_KEY=            # 모델 비교 실험용 <여기에 주입>
