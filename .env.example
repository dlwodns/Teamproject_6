# 복사해서 .env로 쓰고, 값은 각자 채운다. .env는 올리지 않는다.

# --- ai 서비스 (backend가 부르는 주소) ---
AI_SERVICE_URL=http://localhost:8001

# --- 엑사원 (ai/에서만 읽는다). 서비스에서 쓰는 외부 모델 키는 엑사원 API 하나뿐이다(D53). 다른 외부 모델 키는 아래 평가 전용 칸에만 둔다 ---
# 엑사원 API 키. 실제 키는 .env에만 넣고 레포 · 문서에 쓰지 않는다. 발급: https://docs.exaone.ai/ko/my-profile/api-key
EXAONE_API_KEY=<your-key>
# 기본은 엑사원 API(k-exaone_v2.5), 로컬 ollama는 옵션이다(D51 · D52). API로 바꾸는 설정값은 ai/ 호출부를 고친 뒤 이 자리에 적는다
OLLAMA_BASE_URL=http://localhost:11434
EXAONE_MODEL=hf.co/LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct-GGUF:Q4_K_M   # 모델 받기 · 버전: eval/README.md 1~2절
LLM_BACKEND=ollama             # ollama | llamacpp (둘 다 로컬 실행기)
# 개발 서버에서 PC 엑사원을 쓸 때 아래 값은 scripts/exaone-pc.env 한 곳에 두고 scripts/exaone-pc.sh run 으로 넣는다(AI-D9)
# OLLAMA_UDS=                  # PC 터널 Unix 소켓 경로
# EXAONE_MODEL_DIGEST=         # 고정값: 다르면 엑사원을 부르지 않는다
# OLLAMA_VERSION=              # 고정값: 다르면 엑사원을 부르지 않는다

# --- 메일 연동 ---
MS_GRAPH_CLIENT_ID=            # <여기에 주입>
MS_GRAPH_CLIENT_SECRET=        # <여기에 주입>
MS_GRAPH_REDIRECT_URI=http://localhost:8000/accounts/callback
MAIL_SOURCE=dummy              # dummy | outlook_graph (IMAP은 이번 단계 범위 밖)

# --- 보안 ---
TOKEN_ENCRYPTION_KEY=          # 메일 토큰 암호화 키 <여기에 주입>

# --- 알림 · 리마인더 (backend) ---
VAPID_PUBLIC_KEY=              # 웹 푸시 <여기에 주입>
VAPID_PRIVATE_KEY=             # 웹 푸시 <여기에 주입>
APP_MODE=dev                   # dev | prod (dev에서만 시간 이동 · 리마인더 강제 실행)
DATABASE_URL=sqlite:///./ax.db # backend SQLite 파일 (backend/에서 실행 기준, .gitignore *.db). 배포 방식(INF-11)에 따라 바뀔 수 있다

# --- MCP 서버 (backend, P2) ---
MCP_ACCESS_TOKEN=              # <여기에 주입>

# --- 음성 ---
STT_MODE=browser               # browser | server (server면 ai/의 Whisper)

# --- ai 조정값 (주석이면 코드 기본값. 바꿀 때만 주석을 풀고 값을 적는다) ---
# LLAMACPP_BASE_URL=http://127.0.0.1:30411   # LLM_BACKEND=llamacpp일 때 llama-server 주소
# LLM_TIMEOUT_S=120            # 엑사원 호출 1회 제한 시간(초). PC CPU 첫 호출은 약 120초
# OLLAMA_KEEP_ALIVE=30m        # 모델을 메모리에 두는 시간
# ROUTER_THRESHOLD=0.8         # 규칙 확신도가 이 값 미만이면 엑사원으로 보낸다(0~1)
# LLM_ENABLED=true             # false면 엑사원 없이 규칙 결과만(모델 없는 개발 환경)
# CLASSIFY_PROMPT=v3           # v3(기본) | v5(비교용 후보안)

# --- 평가 전용 (eval/에서만 읽는다. scripts/run_dev.py는 서비스에 넘기지 않는다) ---
ANTHROPIC_API_KEY=             # <여기에 주입>
OPENROUTER_API_KEY=            # 모델 비교 실험용 <여기에 주입>
