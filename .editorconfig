# 편집기 공통 설정 (INF-2, infra/plan.md). VS Code는 EditorConfig 확장을 설치하면 읽는다.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# Windows PowerShell 5.1은 BOM이 없으면 UTF-8 한글을 깨뜨린다
[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

# 마크다운은 줄 끝 공백 두 칸이 줄바꿈이라 지우지 않는다
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
