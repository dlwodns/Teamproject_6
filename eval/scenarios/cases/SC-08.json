{
  "id": "SC-08",
  "title": "중요한 사람 표시(T11 결과)를 바꾸고 되돌리고 다시 하기, 그리고 기억이 메일 분류 입력에 그대로 들어간다",
  "fixture": {
    "base": true
  },
  "steps": [
    {
      "do": "GET /api/agent/memory",
      "expect": {
        "match": {
          "people[*].contact_id": [
            5
          ],
          "people.0.used_by": [
            "제안 카드",
            "메일 분류"
          ],
          "me.used_by": [
            "메일 분류"
          ]
        }
      }
    },
    {
      "do": "PATCH /api/agent/memory/people/7",
      "body": {
        "is_favorite": true
      },
      "expect": {
        "match": {
          "memory.people[*].contact_id": [
            5,
            7
          ]
        }
      },
      "save": {
        "aid": "action_id"
      }
    },
    {
      "do": "GET /api/actions/history",
      "expect": {
        "match": {
          "items.0.text": "중요한 사람 표시를 바꿨어요",
          "items.0.can_undo": true
        }
      }
    },
    {
      "do": "POST /api/actions/${aid}/undo",
      "save": {
        "back": "action_id"
      }
    },
    {
      "do": "GET /api/actions/history",
      "expect": {
        "match": {
          "items.0.state": "undone",
          "items.0.redo_action_id": "${back}"
        }
      }
    },
    {
      "do": "POST /api/actions/${aid}/undo",
      "expect": {
        "status": 409
      }
    },
    {
      "do": "POST /api/actions/${back}/undo"
    },
    {
      "do": "GET /api/agent/memory",
      "expect": {
        "match": {
          "people[*].contact_id": [
            5,
            7
          ]
        }
      }
    }
  ],
  "final": {
    "contacts": {
      "7": {
        "is_favorite": true
      }
    },
    "live_count": 1
  }
}
